#!/usr/bin/env bash
set -euo pipefail

log() { echo "[tmux] $*"; }

load_brew_into_path() {
    if [ ! -x /opt/homebrew/bin/brew ]; then
        return
    fi
    eval "$(/opt/homebrew/bin/brew shellenv)"
}

install_tmux() {
    if command -v tmux &>/dev/null; then
        log "tmux: already installed, skipping"
        return
    fi
    log "tmux: installing..."
    brew install tmux
}

load_brew_into_path
install_tmux
