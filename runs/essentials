#!/usr/bin/env bash
set -e

log() { echo "[essentials] $*"; }

load_brew_into_path() {
    if [ ! -x /opt/homebrew/bin/brew ]; then
        return
    fi
    eval "$(/opt/homebrew/bin/brew shellenv)"
}

install_brew() {
    load_brew_into_path
    if command -v brew &>/dev/null; then
        log "brew: already installed, skipping"
        return
    fi
    log "brew: installing..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    load_brew_into_path
}

install_nvm() {
    if [ -d "$HOME/.nvm" ]; then
        log "nvm: already installed, skipping"
        return
    fi
    log "nvm: installing..."
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | bash
}

install_node() {
    export NVM_DIR="$HOME/.nvm"
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    if ! command -v nvm &>/dev/null; then
        log "node: nvm not available, skipping"
        return
    fi
    if nvm ls --no-colors 2>/dev/null | grep -q "lts/"; then
        log "node: LTS already installed, skipping"
        return
    fi
    log "node: installing LTS..."
    nvm install --lts
}

install_goenv() {
    if command -v goenv &>/dev/null; then
        log "goenv: already installed, skipping"
        return
    fi
    log "goenv: installing..."
    brew install goenv
}

install_go() {
    export GOENV_ROOT="$HOME/.goenv"
    export PATH="$GOENV_ROOT/bin:$PATH"
    if ! command -v goenv &>/dev/null; then
        log "go: goenv not available, skipping"
        return
    fi
    eval "$(goenv init -)"

    latest=$(goenv install --list | grep -E '^\s+[0-9]+\.[0-9]+\.[0-9]+$' | tail -1 | tr -d ' ')
    if goenv versions 2>/dev/null | grep -qF "$latest"; then
        log "go: $latest already installed, skipping"
        return
    fi
    log "go: installing $latest..."
    goenv install "$latest"
    goenv global "$latest"
}

install_git() {
    if brew list git &>/dev/null; then
        log "git: already installed, skipping"
        return
    fi
    log "git: installing..."
    brew install git
}

install_gh() {
    if command -v gh &>/dev/null; then
        log "gh: already installed, skipping"
        return
    fi
    log "gh: installing..."
    brew install gh
}

install_docker() {
    if command -v docker &>/dev/null; then
        log "docker: already installed, skipping"
        return
    fi
    log "docker: installing..."
    brew install docker
}

install_colima() {
    if command -v colima &>/dev/null; then
        log "colima: already installed, skipping"
        return
    fi
    log "colima: installing..."
    brew install colima
}

install_docker_compose() {
    if command -v docker-compose &>/dev/null; then
        log "docker-compose: already installed, skipping"
        return
    fi
    log "docker-compose: installing..."
    brew install docker-compose
}

install_pnpm() {
    if command -v pnpm &>/dev/null; then
        log "pnpm: already installed, skipping"
        return
    fi
    log "pnpm: installing..."
    brew install pnpm
}

install_postgresql() {
    if brew list postgresql@17 &>/dev/null; then
        log "postgresql@17: already installed, skipping"
        return
    fi
    log "postgresql@17: installing..."
    brew install postgresql@17
}

install_ghostty() {
    if [ -d "/Applications/Ghostty.app" ]; then
        log "ghostty: already installed, skipping"
        return
    fi
    log "ghostty: installing..."
    brew install --cask ghostty
}

install_arc() {
    if [ -d "/Applications/Arc.app" ]; then
        log "arc: already installed, skipping"
        return
    fi
    log "arc: installing..."
    brew install --cask arc
}

install_brew
install_git
install_gh
install_nvm
install_node
install_goenv
install_go
install_docker
install_colima
install_docker_compose
install_pnpm
install_postgresql
install_ghostty
install_arc
